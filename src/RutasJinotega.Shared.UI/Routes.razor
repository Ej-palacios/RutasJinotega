<Router AppAssembly="@typeof(Routes).Assembly">
    <Found Context="rutaEncontrada">
        <RouteView RouteData="@rutaEncontrada" DefaultLayout="@typeof(LayoutGlass)" />
        <FocusOnNavigate RouteData="@rutaEncontrada" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(LayoutGlass)">
            <div class="pantalla pantalla-centrada">
                <GlassCard Clase="estado">
                    <h1>Página no encontrada</h1>
                    <a class="btn primario" href="">Volver al inicio</a>
                </GlassCard>
            </div>
        </LayoutView>
    </NotFound>
</Router>
