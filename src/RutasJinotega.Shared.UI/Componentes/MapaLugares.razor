@using RutasJinotega.Shared.UI.Modelos

<MapaCalles Puntos="_puntos"
            SeleccionadoId="Seleccionado?.Lugar.Id"
            AlSeleccionar="SeleccionarAsync"
            Clase="mapa-lugares"
            EtiquetaAria="Mapa de lugares"
            MostrarLinea="false"
            Zoom="13" />

@code {
    private IReadOnlyList<PuntoMapa> _puntos = [];

    [Parameter] public IReadOnlyList<ItemLugar> Items { get; set; } = [];

    [Parameter] public ItemLugar? Seleccionado { get; set; }

    [Parameter] public EventCallback<ItemLugar> AlSeleccionar { get; set; }

    protected override void OnParametersSet() =>
        _puntos = Items
            .Select(i => new PuntoMapa(
                i.Lugar.Id,
                i.Lugar.Latitud,
                i.Lugar.Longitud,
                i.Lugar.IconoPrincipal,
                i.Lugar.Nombre))
            .ToList();

    private async Task SeleccionarAsync(int id)
    {
        var item = Items.FirstOrDefault(i => i.Lugar.Id == id);
        if (item is not null)
        {
            await AlSeleccionar.InvokeAsync(item);
        }
    }
}
